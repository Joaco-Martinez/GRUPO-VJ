generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Si el usuario es CLIENTE, puede estar vinculado a una ficha comercial Client.
  client Client?

  Sale             Sale[]
  StockMovements   StockMovement[]
  accountMovements AccountMovement[]
  remitos          Remito[]

  @@index([role])
  @@index([isActive])
}

model Client {
  id        String         @id @default(uuid())
  nombre    String
  apellido  String
  dni       String         @unique
  telefono  String?
  gmail     String?        @unique
  category  CategoryClient @default(Price)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  addressStreet     String?
  addressNumber     String?
  addressFloor      String?
  addressApartment  String?
  addressCity       String?
  addressProvince   String?
  addressPostalCode String?
  addressNotes      String?

  // Coordenadas para calcular envío con Google Routes API
  latitude  Float?
  longitude Float?

  // Usuario de login para ecommerce/web.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Cuenta corriente
  currentBalance   Float   @default(0)
  creditLimit      Float?
  isAccountEnabled Boolean @default(false)

  sales            Sale[]
  remitos          Remito[]
  accountMovements AccountMovement[]

  @@index([dni])
  @@index([gmail])
  @@index([category])
  @@index([userId])
}

model BusinessLocation {
  id   String               @id @default(uuid())
  name String
  type BusinessLocationType @default(BRANCH)

  addressStreet     String?
  addressNumber     String?
  addressCity       String?
  addressProvince   String?
  addressPostalCode String?
  addressNotes      String?

  latitude  Float?
  longitude Float?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales   Sale[]
  remitos Remito[]

  @@index([type])
  @@index([isDefault])
  @@index([isActive])
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@index([isActive])
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  type        ProductType @default(SIMPLE)

  // Precios para venta por unidad
  // price = precio público
  // clientPrice = precio cliente
  // wholesalePrice = precio mayorista
  price          Float
  wholesalePrice Float
  clientPrice    Float

  // Costo de compra base.
  // Para productos UNIT = costo por unidad.
  // Para productos KG = costo por kilogramo.
  // Para productos COMPUESTOS, el costo real de venta se calcula desde sus componentes.
  purchasePrice Float @default(0)

  // Stock por unidad
  minStock      Int?
  stockLocal    Int  @default(0)
  stockDeposito Int  @default(0)

  // Categoría dinámica
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  imageUrl  String?
  imageId   String?
  isService Boolean @default(false)
  isActive  Boolean @default(true)
  sku       String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Venta por unidad o por KG
  saleUnit SaleUnit @default(UNIT)

  // Precios por KG
  pricePerKg          Float?
  wholesalePricePerKg Float?
  clientPricePerKg    Float?

  // Stock por KG
  stockLocalKg    Float  @default(0)
  stockDepositoKg Float  @default(0)
  minStockKg      Float? @default(0)

  // Producto compuesto:
  // Si este producto es una promo/pack/caja, acá van sus componentes.
  components ProductComponent[] @relation("CompositeProduct")

  // Si este producto simple participa dentro de una promo/pack/caja.
  usedIn ProductComponent[] @relation("ComponentProduct")

  SaleItem      SaleItem[]
  remitoItems   RemitoItem[]
  BoxContent    BoxContent[]
  StockMovement StockMovement[]
  alerts        Alert[]
  stats         ProductStats[]

  @@index([sku])
  @@index([categoryId])
  @@index([type])
  @@index([isActive])
}

model ProductComponent {
  id String @id @default(uuid())

  compositeId String
  composite   Product @relation("CompositeProduct", fields: [compositeId], references: [id], onDelete: Cascade)

  componentId String
  component   Product @relation("ComponentProduct", fields: [componentId], references: [id])

  quantity   Int?
  quantityKg Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([compositeId, componentId])
  @@index([componentId])
}

model ArcaConfig {
  id String @id @default(uuid())

  // Configuracion fiscal unica para Grupo VJ.
  // No es multi-tenant: este ERP/POS pertenece a Grupo VJ.
  scope String @unique @default("GRUPO_VJ")

  businessName  String
  cuit          String
  ivaCondition  String?
  fiscalAddress String?
  iibb          String?
  activityStart DateTime?

  csrEncrypted   String?
  csrGeneratedAt DateTime?

  environment ArcaEnvironment  @default(HOMOLOGACION)
  status      ArcaConfigStatus @default(INACTIVE)

  defaultPointOfSale Int?
  defaultCurrencyId  String @default("PES")
  defaultConcept     Int    @default(1)

  certEncrypted String?
  keyEncrypted  String?
  certAlias     String?
  certExpiresAt DateTime?

  lastTokenAt   DateTime?
  lastCheckAt   DateTime?
  lastError     String?
  lastSuccessAt DateTime?

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens       AfipToken[]
  pointsOfSale ArcaPointOfSale[]
  remitoCais   RemitoCaiConfig[]
  remitos      Remito[]
  auditLogs    ArcaAuditLog[]

  @@index([cuit])
  @@index([isActive])
  @@index([environment])
  @@index([status])
}

model AfipToken {
  id String @id @default(uuid())

  arcaConfigId String
  arcaConfig   ArcaConfig @relation(fields: [arcaConfigId], references: [id], onDelete: Cascade)

  service        String   @default("wsfe")
  tokenEncrypted String
  signEncrypted  String
  expiration     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([arcaConfigId, service])
  @@index([expiration])
}

model ArcaPointOfSale {
  id String @id @default(uuid())

  arcaConfigId String
  arcaConfig   ArcaConfig @relation(fields: [arcaConfigId], references: [id], onDelete: Cascade)

  number      Int
  description String?
  enabled     Boolean @default(true)
  isDefault   Boolean @default(false)

  // Tipos AFIP habilitados, por ejemplo [1, 6, 11, 3, 8, 13].
  enabledCbteTypes Int[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([arcaConfigId, number])
  @@index([number])
  @@index([enabled])
}

model RemitoCaiConfig {
  id String @id @default(uuid())

  arcaConfigId String
  arcaConfig   ArcaConfig @relation(fields: [arcaConfigId], references: [id], onDelete: Cascade)

  mode        RemitoMode @default(PREPRINTED_FORM)
  pointOfSale Int
  cai         String
  expiresAt   DateTime
  rangeFrom   Int?
  rangeTo     Int?
  nextNumber  Int?
  enabled     Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  remitos Remito[]

  @@index([pointOfSale])
  @@index([enabled])
  @@index([expiresAt])
}

model Remito {
  id String @id @default(uuid())

  // Venta origen.
  // No es obligatorio para permitir remitos manuales en el futuro.
  // Por ahora lo vamos a generar desde una venta aceptada o facturada.
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  businessLocationId String?
  businessLocation   BusinessLocation? @relation(fields: [businessLocationId], references: [id], onDelete: SetNull)

  // Configuración fiscal usada al momento de emitir.
  arcaConfigId String?
  arcaConfig   ArcaConfig? @relation(fields: [arcaConfigId], references: [id], onDelete: SetNull)

  // CAI configurado usado para este remito.
  remitoCaiConfigId String?
  remitoCaiConfig   RemitoCaiConfig? @relation(fields: [remitoCaiConfigId], references: [id], onDelete: SetNull)

  // Datos propios del comprobante.
  status RemitoStatus @default(ISSUED)
  mode   RemitoMode   @default(DIGITAL_FULL)

  pointOfSale Int
  number      Int
  fullNumber  String @unique

  // Para remito R suele ser código 91.
  code String @default("91")

  issueDate    DateTime @default(now())
  placeOfIssue String?

  // Snapshot del CAI.
  // Esto se guarda en el remito para que aunque después cambies el CAI,
  // el remito viejo siga mostrando el CAI original.
  cai          String?
  caiExpiresAt DateTime?
  caiRangeFrom Int?
  caiRangeTo   Int?

  // Snapshot fiscal de Grupo VJ.
  businessName          String?
  businessCuit          String?
  businessIvaCondition  String?
  businessIibb          String?
  businessActivityStart DateTime?
  businessFiscalAddress String?
  businessAddress       String?
  businessEmail         String?
  businessPhone         String?

  // Snapshot del cliente.
  clientName         String?
  clientDni          String?
  clientCuit         String?
  clientIvaCondition String?
  clientAddress      String?
  clientLocality     String?

  // Datos logísticos / comerciales.
  sellerName    String?
  saleCondition String?
  transportName String?
  transportCuit String?
  packagesCount Int?
  declaredValue Float?
  observations  String?

  pdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items RemitoItem[]

  @@unique([pointOfSale, number])
  @@index([saleId])
  @@index([clientId])
  @@index([userId])
  @@index([businessLocationId])
  @@index([arcaConfigId])
  @@index([remitoCaiConfigId])
  @@index([status])
  @@index([issueDate])
}

model RemitoItem {
  id String @id @default(uuid())

  remitoId String
  remito   Remito @relation(fields: [remitoId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  code        String?
  description String

  quantity   Int?
  quantityKg Float?
  saleUnit   SaleUnit @default(UNIT)

  createdAt DateTime @default(now())

  @@index([remitoId])
  @@index([productId])
}

model ArcaAuditLog {
  id String @id @default(uuid())

  arcaConfigId String?
  arcaConfig   ArcaConfig? @relation(fields: [arcaConfigId], references: [id], onDelete: SetNull)

  userId String?
  action ArcaAuditAction
  detail String?
  ip     String?

  createdAt DateTime @default(now())

  @@index([arcaConfigId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model CbteCounter {
  id         String   @id @default(uuid())
  ptoVta     Int
  cbteTipo   Int
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ptoVta, cbteTipo])
}

model InvoiceAfip {
  id     String  @id @default(uuid())
  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  relatedInvoiceId String?
  relatedInvoice   InvoiceAfip?  @relation("CreditNoteRelation", fields: [relatedInvoiceId], references: [id])
  creditNotes      InvoiceAfip[] @relation("CreditNoteRelation")

  cuit                 String
  puntoVenta           Int
  tipoComprobante      Int
  tipoDoc              Int
  nroDoc               BigInt
  numero               Int
  fechaEmision         DateTime
  resultado            String
  cae                  String?
  caeVto               DateTime?
  total                Float
  neto                 Float
  iva                  Float
  condicionIVAReceptor Int
  moneda               String    @default("PES")
  urlQR                String?
  qrBase64             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([puntoVenta, tipoComprobante, numero])
  @@index([cuit, puntoVenta, tipoComprobante])
}

model Sale {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  businessLocationId String?
  businessLocation   BusinessLocation? @relation(fields: [businessLocationId], references: [id], onDelete: SetNull)

  gmailSend          String?
  deliveryPricePerKm Float?

  subtotal    Float @default(0)
  total       Float @default(0)
  grossProfit Float @default(0)

  quotationExpiresAt DateTime?
  quotationExpiredAt DateTime?
  quotationPdfUrl    String?

  discountType  DiscountType?
  discountValue Float?

  isInvoiced   Boolean @default(false)
  isNoteCredit Boolean @default(false)

  invoiceStatus   InvoiceStatus @default(NONE)
  afipLastError   String?
  nextRetryAt     DateTime?
  retryCount      Int           @default(0)
  afipPayloadJson Json?

  paymentMethod PaymentMethod
  receiptType   ReceiptType
  status        SaleStatus    @default(PENDING)

  // Sirve para devolver el stock al mismo lugar si se cancela.
  stockLocation Location @default(LOCAL)

  // Envío / logística
  deliveryMethod          DeliveryMethod @default(PICKUP)
  deliveryStatus          DeliveryStatus @default(NONE)
  deliveryAddressSnapshot String?
  deliveryDistanceKm      Float?
  deliveryCost            Float          @default(0)

  transportName String?
  transportCuit String?

  packagesCount Int?
  declaredValue Float?

  // Cuenta corriente
  isAccountSale     Boolean @default(false)
  accountDebtAmount Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceAfip      InvoiceAfip?
  pdfUrl           String?
  invoice          Invoice?
  items            SaleItem[]
  payments         SalePayment[]
  remitos          Remito[]
  accountMovements AccountMovement[]

  @@index([quotationExpiresAt])
  @@index([clientId])
  @@index([userId])
  @@index([businessLocationId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity   Int
  quantityKg Float?

  price    Float
  subtotal Float @default(0)

  // Costo historico al momento de vender.
  // En SIMPLE: costo por unidad/KG.
  // En COMPUESTO: costo total de componentes por 1 unidad del producto padre.
  purchasePriceSnapshot Float @default(0)

  // Utilidad bruta del item, con descuento proporcional aplicado.
  profit Float @default(0)

  productNameSnapshot String?
  productSkuSnapshot  String?

  boxContents BoxContent[]

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model BoxContent {
  id         String   @id @default(uuid())
  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity   Int?
  quantityKg Float?

  @@index([saleItemId])
  @@index([productId])
}

model SalePayment {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  method PaymentMethod
  amount Float

  reference String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([method])
}

model AccountMovement {
  id String @id @default(uuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type AccountMovementType

  amount Float

  previousBalance Float
  newBalance      Float

  paymentMethod PaymentMethod?
  reference      String?
  description    String?

  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([saleId])
  @@index([type])
  @@index([date])
}

model Alert {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  message   String
  createdAt DateTime @default(now())
  resolved  Boolean  @default(false)

  @@index([productId])
  @@index([resolved])
}

model ProductStats {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity   Int?
  quantityKg Float?

  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([date])
}

model Finance {
  id            String          @id @default(uuid())
  type          FinanceType
  amount        Float
  category      CategoryFinance
  paymentMethod PaymentMethod?
  description   String?
  date          DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([type])
  @@index([category])
  @@index([date])
}

model StockMovement {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  type MovementType

  from Location?
  to   Location?

  quantity   Int?
  quantityKg Float?

  reason    String?
  reference String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Invoice {
  id        String   @id @default(uuid())
  saleId    String   @unique
  sale      Sale     @relation(fields: [saleId], references: [id])
  pdfUrl    String?
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  EMPLEADO
  CLIENTE
  CONTADOR
}

enum ArcaEnvironment {
  HOMOLOGACION
  PRODUCCION
}

enum ArcaConfigStatus {
  ACTIVE
  INACTIVE
  ERROR
  INCOMPLETE
  CERT_EXPIRED
}

enum CategoryClient {
  Price
  Cliente
  Mayorista
}

enum ProductType {
  SIMPLE
  COMPUESTO
}

enum SaleUnit {
  UNIT
  KG
}

enum MovementType {
  TRANSFER
  INGRESS
  ADJUSTMENT
  SALE
  SALE_CANCEL
}

enum Location {
  LOCAL
  DEPOSITO
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum InvoiceStatus {
  NONE
  PENDING_AFIP
  INVOICED
  ERROR
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  QR
  DEBITO
  CREDITO
  QR_NACION
  QR_MERCADOPAGO
  TARJETA_DEBITO
  TARJETA_CREDITO
  CUENTA_CORRIENTE
}

enum ReceiptType {
  TICKET
  FACTURA
}

enum FinanceType {
  INGRESO
  EGRESO
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AccountMovementType {
  DEBT
  PAYMENT
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
  CREDIT_NOTE
}

enum CategoryFinance {
  VENTA
  COBRANZA
  AlquilerL1
  AlquilerF1
  Alarma
  Sueldos
  MateriaPrima
  Impuestos
  VEP
  Contadora
  Arca
  Eenvios
  Publicidad
  Otro
}

enum RemitoMode {
  DIGITAL_FULL
  PREPRINTED_FORM
}

enum RemitoStatus {
  DRAFT
  ISSUED
  DELIVERED
  CANCELLED
}

enum ArcaAuditAction {
  CREATE_CONFIG
  UPDATE_CONFIG
  UPLOAD_CERTIFICATE
  DELETE_CERTIFICATE
  TEST_WSAA
  TEST_WSFE_DUMMY
  UPSERT_POINT_OF_SALE
  DELETE_POINT_OF_SALE
  UPSERT_REMITO_CAI
  DELETE_REMITO_CAI
}

enum BusinessLocationType {
  BRANCH
  WAREHOUSE
  STORE
}

enum DeliveryMethod {
  PICKUP
  LOCAL_DELIVERY
  TRANSPORT
}

enum DeliveryStatus {
  NONE
  PENDING
  PREPARING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}